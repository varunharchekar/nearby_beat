{
  "name": "nearby",
  "version": "0.3.0",
  "private": true,
  "description": "On-demand research report of meaningful physical changes near an address, with a hand-off to a separate subscription service.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "NEARBY_MODE=fixture node --watch src/main.ts",
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "refresh": "node --env-file-if-exists=.env src/cli.ts refresh",
    "research:check": "node --env-file-if-exists=.env src/cli.ts research-check",
    "check:sources": "node --env-file-if-exists=.env src/cli.ts check-sources"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
