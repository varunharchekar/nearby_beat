# Copy to .env and fill in. Nothing here is a real secret.

# fixture (default) or live
NEARBY_MODE=live
PORT=3000
BASE_URL=https://nearby.example.com

# 32+ random characters. Signs sessions, one-click unsubscribe links and plan tokens.
SESSION_SECRET=
# 64 hex characters (32 bytes): openssl rand -hex 32. Encrypts addresses and drawn areas at rest.
ADDRESS_ENCRYPTION_KEY=

# PostgreSQL 16 with PostGIS. Without it, data lives in memory.
DATABASE_URL=postgres://nearby:nearby@localhost:5432/nearby

# Mapbox: geocoding, neighborhood boundaries, basemap images. Without it: US Census geocoder, no basemap.
MAPBOX_TOKEN=

# Resend transactional email. Sender domain needs SPF, DKIM and DMARC.
RESEND_API_KEY=
EMAIL_FROM="Nearby <updates@nearby.example.com>"
RESEND_WEBHOOK_SECRET=

# Stripe. Prices are read from Stripe; checkout stays disabled until all four are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Operators who can sign in to /ops (comma-separated).
OPERATOR_EMAILS=

# all: every change needs operator approval. flagged: only conflicts, unlocated records and possible duplicates.
REVIEW_MODE=all
# delivery: count free issues on delivery events. acceptance: count on send, restore on hard bounce.
CREDIT_MODE=delivery

# Coverage area as minLng,minLat,maxLng,maxLat
COVERAGE_NAME="Dallas pilot area: Uptown, Knox Henderson, Lower Greenville, M Streets and Lakewood"
COVERAGE_BBOX=-96.85,32.76,-96.69,32.89

# Local reporting feeds you have permission to use (headline + link only).
# RSS_FEEDS=[{"name":"Example News","url":"https://news.example.com/feed","license":"Headline and link use permitted by agreement"}]
RSS_FEEDS=

# Optional: higher Socrata rate limits for data.texas.gov
SOCRATA_APP_TOKEN=
REFRESH_HOURS=6
