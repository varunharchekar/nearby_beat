# Copy to .env and fill in. Nothing here is a real secret.

NEARBY_MODE=live
PORT=3000
BASE_URL=http://localhost:3000

# 32+ random characters (openssl rand -hex 32)
SESSION_SECRET=
# 64 hex characters (openssl rand -hex 32). Encrypts addresses at rest. Don't change it once you have data.
ADDRESS_ENCRYPTION_KEY=

# Research (required): https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-sonnet-5-5
# articles: recent news, blogs and business announcements only (cheapest, default)
# all: also official Dallas record feeds and government websites
RESEARCH_SOURCES=articles
FETCHES_PER_REPORT=5
FETCH_MAX_TOKENS=6000
SEARCHES_ANNOUNCEMENTS=10
SEARCHES_BALANCED=20
SEARCHES_DEEP=30
LOOKBACK_DAYS=60
REPORT_TIMEOUT_SECONDS=480
REPORTS_PER_DRAFT=3
REPORTS_PER_VISITOR_PER_DAY=3
REPORTS_DAILY_CAP=100

# Geocoding and maps (strongly recommended): https://account.mapbox.com → default public token
MAPBOX_TOKEN=

# Database (recommended). Without it everything is in memory and lost on restart.
DATABASE_URL=postgres://nearby:nearby@localhost:5432/nearby

# Email for subscription confirmations. Without it, links appear in Dev tools → Outbox.
RESEND_API_KEY=
EMAIL_FROM=Nearby <onboarding@resend.dev>

# Subscription service hand-off (optional until that service exists)
SUBSCRIBE_URL=
SUBSCRIPTION_HANDOFF_SECRET=

# Operator console sign-in (comma-separated)
OPERATOR_EMAILS=

# Dev tools page (outbox, operator shortcut). Turn off in production.
DEV_TOOLS=true

# Optional: limit addresses to a bounding box (minLng,minLat,maxLng,maxLat). Empty = any US address.
COVERAGE_BBOX=
COVERAGE_NAME=

# Optional: licensed local news feeds read as official-record context
# RSS_FEEDS=[{"name":"Example News","url":"https://news.example.com/feed","license":"Headline and link use permitted"}]
